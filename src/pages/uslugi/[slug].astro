---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IllustrativePhoto from '../../components/IllustrativePhoto.astro';
import CtaBand from '../../components/CtaBand.astro';

export async function getStaticPaths() {
  const uslugi = await getCollection('uslugi');
  return uslugi.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const base = import.meta.env.BASE_URL;
---

<Base title={item.data.title} description={item.data.summary}>
  <header class="page-hero">
    <div class="wrap">
      <p class="kicker">{item.data.kicker}</p>
      <h1 class="page-title">{item.data.title}</h1>
      <p class="lede">{item.data.summary}</p>
    </div>
  </header>

  <section class="section wrap split">
    <article class="prose">
      <Content />
      <p><a href={`${base}uslugi/`}>← Wszystkie usługi</a></p>
    </article>
    <IllustrativePhoto src={item.data.image} alt={item.data.imageAlt} />
  </section>

  <CtaBand />
</Base>
