---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IllustrativePhoto from '../../components/IllustrativePhoto.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbNode, itemListNode } from '../../lib/jsonld';
import { absUrl } from '../../lib/urls';

const base = import.meta.env.BASE_URL;
const uslugi = (await getCollection('uslugi')).sort((a, b) => a.data.order - b.data.order);
---

<Base
  title="Usługi"
  description="Elewacje, izolacje i renowacja zabytków — zakres Decor Stucco jako wykonawcy robót na obiektach publicznych."
  pageType="CollectionPage"
  jsonLd={[
    itemListNode({
      url: absUrl('uslugi/'),
      name: 'Zakres robót Decor Stucco',
      items: uslugi.map((item) => ({
        name: item.data.title,
        url: absUrl(`uslugi/${item.id}/`),
      })),
    }),
    breadcrumbNode([
      { name: 'Start', url: absUrl() },
      { name: 'Usługi', url: absUrl('uslugi/') },
    ]),
  ]}
>
  <header class="page-hero">
    <div class="wrap">
      <p class="kicker">Zakres</p>
      <h1 class="page-title">Roboty nazwane, nie PKD</h1>
      <p class="lede">
        Trzy filary odpowiadają temu, co firma wygrywa w zamówieniach publicznych. Klatki PPOŻ
        i instalacje pokazujemy przy konkretnych obiektach, nie jako osobny sklep usług.
      </p>
    </div>
  </header>

  <section class="section wrap">
    <div class="card-grid">
      {
        uslugi.map((item) => (
          <a class="service-card" href={`${base}uslugi/${item.id}/`}>
            <span class="badge">0{item.data.order}</span>
            <h3>{item.data.title}</h3>
            <p>{item.data.summary}</p>
            <span class="more">Czytaj zakres →</span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section wrap">
    <IllustrativePhoto
      src="images/rusztowanie.jpg"
      alt="Rusztowanie przy elewacji, ujęcie ilustracyjne."
    />
  </section>

  <CtaBand text="Opisz obiekt i zakres z SIWZ albo z projektu. Nie wyceniamy metrów kwadratowych przez formularz cennikowy." />
</Base>
