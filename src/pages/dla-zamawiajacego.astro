---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqItems } from '../data/faq';
import { site } from '../data/site';
import { breadcrumbNode, faqQuestions } from '../lib/jsonld';
import { absUrl } from '../lib/urls';
---

<Base
  title="Dla zamawiającego"
  description="Informacje dla zamawiającego publicznego: jak czytać zakres Decor Stucco, jakie dokumenty są na stronie, czego nie ma, FAQ pod SIWZ."
  pageType="FAQPage"
  mainEntity={faqQuestions()}
  jsonLd={[
    breadcrumbNode([
      { name: 'Start', url: absUrl() },
      { name: 'Dla zamawiającego', url: absUrl('dla-zamawiajacego/') },
    ]),
  ]}
>
  <PageHero
    kicker="Wiedza"
    title="Dla zamawiającego publicznego"
    lede="Krótko: kim jesteśmy w postępowaniu, jakie roboty umiemy nazwać, czego nie obiecujemy bez skanu. To nie jest poradnik prawny i nie zastępuje SIWZ."
  />

  <section class="section wrap">
    <article class="prose">
      <h2>Checklista przed zapytaniem</h2>
      <ul>
        <li>Obiekt i adres — choćby roboczo.</li>
        <li>Zakres: elewacja, izolacja, zabytek, inny (PPOŻ, instalacje — tylko jeśli tak jest w dokumentacji).</li>
        <li>Czy obiekt jest wpisany / objęty ochroną konserwatorską.</li>
        <li>Termin: postępowanie, zapytanie ofertowe, czy rozpoznanie rynku.</li>
        <li>Czy potrzebujecie wykazu realizacji z nazwą zamawiającego do załącznika.</li>
      </ul>

      <h2>Co można sprawdzić bez telefonu</h2>
      <p>
        NIP {site.nip}, REGON {site.regon}, forma JDG, adres {site.address.city}. Wykaz
        realizacji na tej stronie odpowiada publicznym ogłoszeniom (obiekt, zamawiający, rok,
        zakres). Kwot umów tu nie publikujemy.
      </p>

      <h2>Dokumenty, których jeszcze nie ma w pliku</h2>
      <p>
        Polisa OC (suma), ISO, uprawnienia kierownika, pozwolenie WKZ, referencja z klauzulą
        należytego wykonania. Gdy właściciel przekaże PDF, wstawimy je do pobrania. Do tego
        czasu nie ma „pobierz certyfikat” prowadzącego donikąd.
      </p>
    </article>

    <div class="faq" style="margin-top: 3rem; max-width: 40rem;">
      <h2 class="page-title" style="font-size: 1.85rem; margin-bottom: 1rem;">Pytania</h2>
      {
        faqItems.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </section>

  <CtaBand title="Zapytanie do postępowania" />
</Base>
