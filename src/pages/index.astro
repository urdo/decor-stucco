---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { itemListNode } from '../lib/jsonld';
import { absUrl } from '../lib/urls';

const base = import.meta.env.BASE_URL;
const featured = (await getCollection('realizacje'))
  .filter((item) => item.data.featured)
  .sort((a, b) => b.data.year - a.data.year);

const cards = [
  {
    name: 'Uniwersytet Warszawski',
    image: 'images/zabytki.jpg',
    objectPosition: 'center 30%',
    href: `${base}realizacje/`,
  },
  {
    name: 'Politechnika Gdańska',
    image: 'images/elewacja.jpg',
    objectPosition: 'center 35%',
    href: `${base}realizacje/`,
  },
  {
    name: 'Ministerstwo Edukacji i Nauki',
    image: 'images/hero-cinematic-dusk.jpg',
    objectPosition: '72% 32%',
    href: `${base}realizacje/`,
  },
];

const heroSrc = `${base}images/hero-cinematic-dusk.jpg`;
---

<Base
  title={site.name}
  description="Decor Stucco Zenon Szczygieł — wykonawca robót elewacyjnych, izolacyjnych i renowacyjnych na obiektach publicznych. NIP, realizacje z nazwami, Mazowsze i Świętokrzyskie."
  ogImage="images/hero-cinematic-dusk.jpg"
  hideFooter
  jsonLd={[
    itemListNode({
      url: absUrl(),
      name: 'Nazwane realizacje',
      items: featured.map((item) => ({
        name: `${item.data.year} ${item.data.object}`,
        url: absUrl(`realizacje/${item.id}/`),
      })),
    }),
  ]}
>
  <section class="hero-cinematic" aria-label="Wstęp">
    <div class="hero-media" aria-hidden="true">
      <img
        src={heroSrc}
        alt=""
        width="2400"
        height="1600"
        fetchpriority="high"
        decoding="async"
      />
      <div class="hero-scrim"></div>
    </div>
    <div class="hero-content wrap">
      <h1>
        <span class="hero-line">Nazwane realizacje.</span>
        <span class="hero-line">Sprawdzalne dane.</span>
      </h1>
      <p class="lede">Fasady dla instytucji publicznych, które stoją na lata.</p>
      <div class="hero-actions">
        <a class="btn" href={`${base}kontakt/`}>Zapytanie</a>
        <a class="btn btn-ghost" href={`${base}realizacje/`}>Realizacje</a>
      </div>
    </div>
  </section>

  <section class="featured-strip" aria-label="Wybrane realizacje">
    <div class="wrap">
      <p class="featured-label">Wybrane realizacje</p>
      <div class="featured-cards">
        {
          cards.map((card) => (
            <a class="featured-card" href={card.href}>
              <img
                src={`${base}${card.image}`}
                alt=""
                width="900"
                height="560"
                loading="lazy"
                style={`object-position: ${card.objectPosition}`}
              />
              <span class="featured-card-caption">
                <span class="featured-card-name">{card.name}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>
