---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ProofBar from '../components/ProofBar.astro';
import ObjectRow from '../components/ObjectRow.astro';
import IllustrativePhoto from '../components/IllustrativePhoto.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import { itemListNode } from '../lib/jsonld';
import { absUrl } from '../lib/urls';

const base = import.meta.env.BASE_URL;
const uslugi = (await getCollection('uslugi')).sort((a, b) => a.data.order - b.data.order);
const featured = (await getCollection('realizacje'))
  .filter((item) => item.data.featured)
  .sort((a, b) => b.data.year - a.data.year);
---

<Base
  title={site.name}
  bodyClass="home"
  description="Decor Stucco Zenon Szczygieł — wykonawca robót elewacyjnych, izolacyjnych i renowacyjnych na obiektach publicznych. NIP, realizacje z nazwami, Mazowsze i Świętokrzyskie."
  ogImage="images/hero-building.jpg"
  jsonLd={[
    itemListNode({
      url: absUrl(),
      name: 'Nazwane realizacje',
      items: featured.map((item) => ({
        name: `${item.data.year} ${item.data.object}`,
        url: absUrl(`realizacje/${item.id}/`),
      })),
    }),
  ]}
>
  <section class="hero-full">
    <div class="hero-full-media">
      <img
        src={`${base}images/hero-building.jpg`}
        alt="Rozświetlona neoklasyczna fasada gmachu instytucji publicznej o zmierzchu."
        width="1600"
        height="900"
        fetchpriority="high"
      />
    </div>
    <div class="hero-full-inner">
      <h1 class="hero-title">Nazwane realizacje.<br />Sprawdzalne dane.</h1>
      <p class="hero-sub">Fasady dla instytucji publicznych, które stoją na lata.</p>
      <div class="hero-actions">
        <a class="btn btn-gold" href={`${base}kontakt/`}>Zapytanie</a>
        <a class="btn btn-outline" href={`${base}realizacje/`}>Realizacje</a>
      </div>
    </div>
  </section>

  <section class="showcase wrap">
    <p class="eyebrow">Wybrane realizacje</p>
    <div class="showcase-grid">
      <a class="showcase-card" href={`${base}realizacje/dworek-zabia-wola/`}>
        <img src={`${base}images/showcase-zabia-wola.jpg`} alt="Dworek / Dom Kultury Żabia Wola — zabytkowy dworek." loading="lazy" />
        <span class="showcase-name">Dworek / Dom Kultury Żabia Wola</span>
      </a>
      <a class="showcase-card" href={`${base}realizacje/gmach-elektroniki-pw/`}>
        <img src={`${base}images/showcase-pw.jpg`} alt="Gmach Elektroniki Politechniki Warszawskiej — fasada." loading="lazy" />
        <span class="showcase-name">Gmach Elektroniki PW</span>
      </a>
      <a class="showcase-card" href={`${base}realizacje/teatr-dramatyczny-pkin/`}>
        <img src={`${base}images/showcase-teatr-pkin.jpg`} alt="Teatr Dramatyczny, PKiN — portyk i wieża Pałacu Kultury." loading="lazy" />
        <span class="showcase-name">Teatr Dramatyczny, PKiN</span>
      </a>
    </div>
  </section>

  <ProofBar />

  <section class="section wrap">
    <div class="split">
      <div>
        <div class="section-head">
          <p class="kicker">Zakres</p>
          <h2>Trzy filary, nazwane robotami</h2>
          <p>
            Oferta wynika z tego, co widać w zamówieniach publicznych: elewacje, izolacje i
            renowacja zabytków. Nie z numeru PKD i nie z nazwy „stucco”.
          </p>
        </div>
        <div class="card-grid" style="grid-template-columns: 1fr;">
          {
            uslugi.map((item) => (
              <a class="service-card" href={`${base}uslugi/${item.id}/`}>
                <span class="badge">0{item.data.order}</span>
                <h3>{item.data.title}</h3>
                <p>{item.data.summary}</p>
                <span class="more">Zakres →</span>
              </a>
            ))
          }
        </div>
      </div>
      <IllustrativePhoto
        src="images/elewacja.jpg"
        alt="Jasna fasada budynku, ujęcie architektoniczne."
      />
    </div>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <p class="kicker">Portfel</p>
      <h2>Obiekty z nazwą zamawiającego</h2>
      <p>
        To, czego nie mają prawie wszyscy konkurenci. Kwot z portali przetargowych tu nie ma —
        są adres, instytucja i rok.
      </p>
    </div>
    <div class="object-grid">
      {
        featured.map((item) => (
          <ObjectRow
            href={`${base}realizacje/${item.id}/`}
            year={item.data.year}
            name={item.data.object}
            meta={`${item.data.client} · ${item.data.location}`}
          />
        ))
      }
    </div>
    <p style="margin-top: 1.5rem;">
      <a href={`${base}realizacje/`}>Pełna lista realizacji</a>
    </p>
  </section>

  <section class="section wrap">
    <div class="section-head">
      <p class="kicker">Dla komisji</p>
      <h2>Dane, które można sprawdzić</h2>
      <p>
        NIP {site.nip}, REGON {site.regon}, forma JDG, adres siedziby. Polisa OC, ISO i skany
        referencji pojawią się, gdy właściciel je przekaże — wcześniej nie wymyślamy dokumentów.
      </p>
    </div>
    <p>
      <a class="btn btn-ghost" href={`${base}dla-zamawiajacego/`}>Informacje dla zamawiającego</a>
      <a class="btn btn-ghost" href={`${base}o-firmie/`} style="margin-left: 0.5rem;">O firmie</a>
    </p>
  </section>

  <CtaBand />
</Base>
