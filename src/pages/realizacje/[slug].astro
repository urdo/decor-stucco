---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import ProofSlots from '../../components/ProofSlots.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbNode, realizationNode } from '../../lib/jsonld';
import { absUrl } from '../../lib/urls';

export async function getStaticPaths() {
  const items = await getCollection('realizacje');
  return items.map((item) => ({
    params: { slug: item.id },
    props: { item },
  }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const base = import.meta.env.BASE_URL;
const pillarLabel = {
  elewacje: 'Elewacje',
  izolacje: 'Izolacje',
  zabytki: 'Zabytki',
  inne: 'Zakres towarzyszący',
}[item.data.pillar];
const pageUrl = absUrl(`realizacje/${item.id}/`);
---

<Base
  title={item.data.title}
  description={`${item.data.object}, ${item.data.client}, ${item.data.year}. ${item.data.scope}`}
  jsonLd={[
    realizationNode({
      url: pageUrl,
      object: item.data.object,
      client: item.data.client,
      year: item.data.year,
      location: item.data.location,
      scope: item.data.scope,
      pillar: pillarLabel,
    }),
    breadcrumbNode([
      { name: 'Start', url: absUrl() },
      { name: 'Realizacje', url: absUrl('realizacje/') },
      { name: item.data.object, url: pageUrl },
    ]),
  ]}
>
  <PageHero kicker={`${item.data.year} · ${pillarLabel}`} title={item.data.object}>
    <ul class="meta-list">
      <li><span>Zamawiający</span> {item.data.client}</li>
      <li><span>Lokalizacja</span> {item.data.location}</li>
      <li><span>Zakres</span> {item.data.scope}</li>
    </ul>
  </PageHero>

  <section class="section wrap split">
    <article class="prose">
      <Content />
      <p class="caption">{item.data.sourceNote}</p>
      <p><a href={`${base}realizacje/`}>← Wszystkie realizacje</a></p>
    </article>
    <div>
      <PhotoFrame label={`Fotografia: ${item.data.object}`} />
      <p class="caption" style="margin-top: 1.25rem;">Dokumenty do tej pozycji</p>
      <div style="margin-top: 0.75rem;">
        <ProofSlots />
      </div>
    </div>
  </section>

  <CtaBand title="To podobny obiekt?" text="Napisz, jaki gmach i jaki zakres. Nie publikujemy referencji, których nie mamy w PDF." />
</Base>
