---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ObjectRow from '../../components/ObjectRow.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import CtaBand from '../../components/CtaBand.astro';
import { breadcrumbNode, itemListNode } from '../../lib/jsonld';
import { absUrl } from '../../lib/urls';

const base = import.meta.env.BASE_URL;
const all = (await getCollection('realizacje')).sort((a, b) => b.data.year - a.data.year);
const featured = all.filter((item) => item.data.featured);
const rest = all.filter((item) => !item.data.featured);
---

<Base
  title="Realizacje"
  description="Nazwane realizacje Decor Stucco: obiekt, zamawiający, rok i zakres z ogłoszenia publicznego. Bez kwot z agregatorów."
  pageType="CollectionPage"
  jsonLd={[
    itemListNode({
      url: absUrl('realizacje/'),
      name: 'Realizacje Decor Stucco',
      items: all.map((item) => ({
        name: `${item.data.year} ${item.data.object}`,
        url: absUrl(`realizacje/${item.id}/`),
      })),
    }),
    breadcrumbNode([
      { name: 'Start', url: absUrl() },
      { name: 'Realizacje', url: absUrl('realizacje/') },
    ]),
  ]}
>
  <PageHero
    kicker="Portfel"
    title="Obiekt, zamawiający, rok"
    lede="Lista z publicznych ogłoszeń o zamówieniach. Nie wstawiamy zdjęć stockowych jako dokumentacji robót. Kwot z Atlasa i eGospodarki tu nie ma."
  />

  <section class="section wrap split">
    <div>
      <h2>Wybrane</h2>
      <div class="object-grid" style="margin-top: 1.25rem;">
        {
          featured.map((item) => (
            <ObjectRow
              href={`${base}realizacje/${item.id}/`}
              year={item.data.year}
              name={item.data.object}
              meta={`${item.data.client} · ${item.data.scope}`}
            />
          ))
        }
      </div>
    </div>
    <PhotoFrame />
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Pozostałe z wykazu</h2>
      <p>
        W tym roboty instalacyjne i wewnętrzne na gmachach instytucjonalnych — z etykietą
        zakresu, bez naginania do filaru „elewacje”.
      </p>
    </div>
    <div class="object-grid">
      {
        rest.map((item) => (
          <ObjectRow
            href={`${base}realizacje/${item.id}/`}
            year={item.data.year}
            name={item.data.object}
            meta={`${item.data.client} · ${item.data.scope}`}
          />
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>
