---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ObjectRow from '../../components/ObjectRow.astro';
import PhotoFrame from '../../components/PhotoFrame.astro';
import CtaBand from '../../components/CtaBand.astro';

const base = import.meta.env.BASE_URL;
const all = (await getCollection('realizacje')).sort((a, b) => b.data.year - a.data.year);
const featured = all.filter((item) => item.data.featured);
const rest = all.filter((item) => !item.data.featured);
---

<Base
  title="Realizacje"
  description="Nazwane realizacje Decor Stucco: obiekt, zamawiający, rok i zakres z ogłoszenia publicznego. Bez kwot z agregatorów."
>
  <header class="page-hero">
    <div class="wrap">
      <p class="kicker">Portfel</p>
      <h1 class="page-title">Obiekt, zamawiający, rok</h1>
      <p class="lede">
        Lista z publicznych ogłoszeń o zamówieniach. Nie wstawiamy zdjęć stockowych jako
        dokumentacji robót. Kwot z Atlasa i eGospodarki tu nie ma.
      </p>
    </div>
  </header>

  <section class="section wrap split">
    <div>
      <h2>Wybrane</h2>
      <div class="object-grid" style="margin-top: 1.25rem;">
        {
          featured.map((item) => (
            <ObjectRow
              href={`${base}realizacje/${item.id}/`}
              year={item.data.year}
              name={item.data.object}
              meta={`${item.data.client} · ${item.data.scope}`}
            />
          ))
        }
      </div>
    </div>
    <PhotoFrame />
  </section>

  <section class="section wrap">
    <div class="section-head">
      <h2>Pozostałe z wykazu</h2>
      <p>
        W tym roboty instalacyjne i wewnętrzne na gmachach instytucjonalnych — z etykietą
        zakresu, bez naginania do filaru „elewacje”.
      </p>
    </div>
    <div class="object-grid">
      {
        rest.map((item) => (
          <ObjectRow
            href={`${base}realizacje/${item.id}/`}
            year={item.data.year}
            name={item.data.object}
            meta={`${item.data.client} · ${item.data.scope}`}
          />
        ))
      }
    </div>
  </section>

  <CtaBand />
</Base>
