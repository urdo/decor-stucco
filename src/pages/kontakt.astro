---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { fullAddress, site } from '../data/site';
import { breadcrumbNode } from '../lib/jsonld';
import { absUrl } from '../lib/urls';
---

<Base
  title="Kontakt"
  description="Zapytanie o ofertę lub udział w postępowaniu — Decor Stucco Zenon Szczygieł. Formularz, dane JDG, NIP i adres siedziby."
  pageType="ContactPage"
  jsonLd={[
    breadcrumbNode([
      { name: 'Start', url: absUrl() },
      { name: 'Kontakt', url: absUrl('kontakt/') },
    ]),
  ]}
>
  <PageHero
    kicker="Kontakt"
    title="Zapytanie o ofertę lub postępowanie"
    lede="Napisz, jaki obiekt i jaki zakres. Telefon i e-mail z katalogów internetowych nie są na stronie, dopóki właściciel nie wskaże danych do publikacji."
  />

  <section class="section wrap split">
    <ContactForm />
    <aside>
      <h2 class="page-title" style="font-size: 1.5rem;">Dane rejestrowe</h2>
      <ul class="meta-list">
        <li><span>Firma</span> {site.legalName}</li>
        <li><span>NIP</span> {site.nip}</li>
        <li><span>REGON</span> {site.regon}</li>
        <li><span>Adres</span> {fullAddress()}</li>
        <li>
          <span>E-mail</span>
          {site.email ? site.email : 'do potwierdzenia przez właściciela'}
        </li>
        <li>
          <span>Telefon</span>
          {site.phone ? site.phone : 'do potwierdzenia przez właściciela'}
        </li>
        <li>
          <span>Osoba</span>
          {site.contactPerson ? site.contactPerson : 'do wskazania przez właściciela'}
        </li>
      </ul>
    </aside>
  </section>
</Base>
