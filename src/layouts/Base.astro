---
import '@fontsource/syne/600.css';
import '@fontsource/syne/700.css';
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/600.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import {
  graphDocument,
  webPageNode,
  type JsonLdNode,
} from '../lib/jsonld';
import { absUrl } from '../lib/urls';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  pageType?: string;
  jsonLd?: JsonLdNode[];
  mainEntity?: JsonLdNode | JsonLdNode[];
  ogImage?: string;
}

const {
  title,
  description,
  noindex = false,
  pageType = 'WebPage',
  jsonLd = [],
  mainEntity,
  ogImage = 'images/hero-cinematic-dusk.jpg',
} = Astro.props;

const pageTitle =
  title === site.name
    ? `${site.legalName} — wykonawca obiektów publicznych`
    : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : absUrl(ogImage);
const llmsHref = absUrl('llms.txt');
const jsonLdRaw = graphDocument([
  webPageNode({
    canonical,
    title: pageTitle,
    description,
    pageType,
    mainEntity,
  }),
  ...jsonLd,
]);
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0a0a" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href={llmsHref} title="llms.txt" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta
      property="og:image:alt"
      content="Zdjęcie ilustracyjne, nie dokumentacja robót Decor Stucco."
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <title>{pageTitle}</title>
    <link rel="icon" href={`${import.meta.env.BASE_URL}favicon.svg`} type="image/svg+xml" />
    <script is:inline type="application/ld+json" set:html={jsonLdRaw} />
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />
  </body>
</html>
