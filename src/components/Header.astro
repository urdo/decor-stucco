---
import { nav, site } from '../data/site';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;
const baseNoSlash = base.replace(/\/+$/, '') || '';

let path = Astro.url.pathname;
if (baseNoSlash && path.startsWith(baseNoSlash)) {
  path = path.slice(baseNoSlash.length) || '/';
}
path = path.replace(/\/+$/, '') || '/';
const isHome = path === '/';

function href(to: string) {
  return `${base}${to.replace(/^\//, '')}`;
}

function isCurrent(itemHref: string) {
  const clean = itemHref.replace(/\/+$/, '') || '/';
  return path === clean || path.startsWith(`${clean}/`);
}
---

<header class:list={['site-header', { 'is-solid': !isHome }]} data-site-header data-home={isHome ? '1' : '0'}>
  <div class="wrap header-inner">
    <a class="wordmark" href={base}>
      <span class="wordmark-name">Decor Stucco</span>
    </a>
    <nav class="nav-desktop" aria-label="Główne">
      {
        nav.map((item) => (
          <a href={href(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-mobilne"
      aria-label="Otwórz menu"
      data-menu-toggle
    >
      <span class="burger" aria-hidden="true"></span>
      <span class="menu-toggle-text">Menu</span>
    </button>
  </div>
  <nav class="nav-mobile wrap" id="menu-mobilne" data-menu>
    {
      nav.map((item) => (
        <a href={href(item.href)} aria-current={isCurrent(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>
</header>

<script>
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-menu]');
  const header = document.querySelector('[data-site-header]');
  const isHome = header?.getAttribute('data-home') === '1';

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('is-open');
    toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    toggle.setAttribute('aria-label', open ? 'Zamknij menu' : 'Otwórz menu');
    if (isHome && open) header?.classList.add('is-solid');
    if (isHome && !open && window.scrollY < 40) header?.classList.remove('is-solid');
  });

  if (isHome && header) {
    const onScroll = () => {
      if (window.scrollY > 40 || menu?.classList.contains('is-open')) {
        header.classList.add('is-solid');
      } else {
        header.classList.remove('is-solid');
      }
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
