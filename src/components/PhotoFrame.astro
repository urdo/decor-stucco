---
interface Props {
  label?: string;
  hint?: string;
}

const {
  label = 'Fotografia obiektu',
  hint = 'Do uzupełnienia przez właściciela: obiekt, zamawiający, rok. Nie wstawiamy zdjęcia stockowego jako realizacji.',
} = Astro.props;
---

<div class="photo-frame" role="img" aria-label={`${label}. ${hint}`}>
  <div>
    <strong>{label}</strong>
    {hint}
  </div>
</div>
