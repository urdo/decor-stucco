---
interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption = 'Zdjęcie ilustracyjne, nie dokumentacja robót Decor Stucco.' } = Astro.props;
const url = src.startsWith('http') ? src : `${import.meta.env.BASE_URL}${src.replace(/^\//, '')}`;
---

<figure class="figure-block">
  <img src={url} alt={alt} loading="lazy" width="1600" height="1000" />
  <figcaption class="caption">{caption}</figcaption>
</figure>
